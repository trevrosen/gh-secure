#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

head=$(git rev-parse HEAD)
has_updates=false
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deletions do not introduce code to validate.
    case "$local_oid" in
        *[!0]*) ;;
        *) continue ;;
    esac
    commit=$(git rev-parse --verify "$local_oid^{commit}")
    if [ "$commit" != "$head" ]; then
        echo "pre-push: $local_ref is not checked-out HEAD; check it out and push separately." >&2
        exit 1
    fi
    has_updates=true
done

if [ "$has_updates" = false ]; then
    exit 0
fi

status=$(git status --porcelain --untracked-files=all)
if [ -n "$status" ]; then
    echo "pre-push: commit or stash tracked and untracked changes so checks validate the pushed code." >&2
    exit 1
fi

echo "pre-push: running make check"
exec make check
